{
  "name": "soma_app",
  "version": "1.2.2",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:public": "node scripts/dev-public.mjs",
    "start": "node scripts/dev.mjs",
    "start:expo": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "desktop": "node scripts/dev-desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:preview": "node scripts/desktop-preview.mjs --open",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.viewer.json",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "prepare:offline": "node scripts/prepare-offline.mjs",
    "prepare:thumbnails": "node scripts/render-offline-thumbnails.mjs && node scripts/thumbnail-display.cjs",
    "qa:offline": "node scripts/qa-offline.mjs",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "qa:viewer": "node scripts/qa-viewer.cjs",
    "qa:models": "node scripts/qa-model-catalogue.cjs",
    "qa:web": "node scripts/qa-web.cjs",
    "qa:android": "node scripts/qa-android.cjs",
    "postinstall": "node scripts/patch-dependencies.cjs",
    "test:security": "node scripts/test-dependency-security.cjs",
    "format": "prettier --write src viewer scripts tests *.ts *.js *.json .github/workflows/*.yml",
    "format:check": "prettier --check src viewer scripts tests *.ts *.js *.json .github/workflows/*.yml",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:security",
    "qa:layout": "node scripts/qa-layout.cjs",
    "qa:atlas": "node scripts/qa-atlas.cjs",
    "qa:account": "node scripts/qa-account-api.cjs && node scripts/qa-account-ui.cjs",
    "qa:oauth": "node scripts/qa-desktop-oauth.cjs",
    "qa:auth": "node scripts/qa-auth-web.cjs",
    "verify:offline": "node scripts/verify-offline.mjs",
    "qa:learning": "node scripts/qa-learning.cjs",
    "qa:desktop": "node scripts/qa-desktop.cjs",
    "viewer:build": "node scripts/build-viewer.mjs",
    "viewer:check": "node scripts/build-viewer.mjs --check",
    "prepare:gateway": "node scripts/prepare-gateway.mjs",
    "audit:security": "node scripts/audit-dependencies.mjs",
    "qa:premium": "node scripts/qa-premium.cjs"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "node-forge": "^1.4.2",
    "zod": "^4.6.6",
    "query-string": {
      "decode-uri-component": "^0.5.1"
    }
  }
}
