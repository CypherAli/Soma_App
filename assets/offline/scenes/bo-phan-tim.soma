t coronary artery","english":"Posterior interventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2699":{"id":"FJ2699","meshName":"FJ2699","label":"Liên thất sau và nhánh thất sau — Posterior interventricular branch of right coronary artery","english":"Posterior interventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2700":{"id":"FJ2700","meshName":"FJ2700","label":"Liên thất sau và nhánh thất sau — Posterior interventricular branch of right coronary artery","english":"Posterior interventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2714":{"id":"FJ2714","meshName":"FJ2714","label":"Liên thất sau và nhánh thất sau — First posterior ventricular branch of right coronary artery","english":"First posterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2715":{"id":"FJ2715","meshName":"FJ2715","label":"Liên thất sau và nhánh thất sau — First posterior ventricular branch of right coronary artery","english":"First posterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2716":{"id":"FJ2716","meshName":"FJ2716","label":"Liên thất sau và nhánh thất sau — First posterior ventricular branch of right coronary artery","english":"First posterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2717":{"id":"FJ2717","meshName":"FJ2717","label":"Liên thất sau và nhánh thất sau — First posterior ventricular branch of right coronary artery","english":"First posterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2718":{"id":"FJ2718","meshName":"FJ2718","label":"Liên thất sau và nhánh thất sau — First posterior ventricular branch of right coronary artery","english":"First posterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2719":{"id":"FJ2719","meshName":"FJ2719","label":"Liên thất sau và nhánh thất sau — First posterior ventricular branch of right coronary artery","english":"First posterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2720":{"id":"FJ2720","meshName":"FJ2720","label":"Liên thất sau và nhánh thất sau — First posterior ventricular branch of right coronary artery","english":"First posterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2721":{"id":"FJ2721","meshName":"FJ2721","label":"Liên thất sau và nhánh thất sau — First posterior ventricular branch of right coronary artery","english":"First posterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2722":{"id":"FJ2722","meshName":"FJ2722","label":"Liên thất sau và nhánh thất sau — First posterior ventricular branch of right coronary artery","english":"First posterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2723":{"id":"FJ2723","meshName":"FJ2723","label":"Động mạch vành phải và nhánh bờ — Trunk of right coronary artery","english":"Trunk of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2737":{"id":"FJ2737","meshName":"FJ2737","label":"Thân chung động mạch vành trái","english":"Trunk of left coronary artery","latin":"A. coronaria sinistra (truncus)","note":"Đoạn ngắn 1–2cm từ xoang vành trái đến chỗ chia LAD và mũ. Hẹp thân chung đe doạ cùng lúc khoảng 3/4 cơ thất trái — tổn thương \"widow maker\", thường phải mổ bắc cầu.","sources":[{"title":"Bài giải phẫu Soma","path":"src/lib/humanAtlas/scenes (dong-mach-vanh/than-chung-trai)","url":"/giai-phau/mo-hinh/dong-mach-vanh?focus=than-chung-trai"}],"category":"arterial"},"FJ2655":{"id":"FJ2655","meshName":"FJ2655","label":"Xoang vành","english":"Coronary sinus","latin":"Sinus coronarius","note":"Tĩnh mạch lớn thu gom hầu hết máu tĩnh mạch từ cơ tim (qua các tĩnh mạch tim nhỏ hơn), đổ trực tiếp vào tâm nhĩ phải — đường dẫn chính đưa máu đã nuôi tim trở về vòng tuần hoàn.","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (dong-mach-vanh/coronary-sinus)"}],"category":"venous"},"FJ2656":{"id":"FJ2656","meshName":"FJ2656","label":"Tĩnh mạch vành và xoang vành — Great cardiac vein","english":"Great cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2657":{"id":"FJ2657","meshName":"FJ2657","label":"Tĩnh mạch gian thất trước","english":"Anterior interventricular vein","latin":"","note":"","sources":[{"title":"Giải phẫu học — giáo trình Y Hà Nội","page":223,"path":"medical_kb/text/giai-phau-yhn.txt","url":"/tai-lieu-y-khoa?file=Gi%E1%BA%A3i%20Ph%E1%BA%ABu%20Ng%C6%B0%E1%BB%9Di%20Y%20H%C3%A0%20N%E1%BB%99i%202006%20%C4%90%E1%BB%8F%20%C4%90en.pdf&page=223"}],"category":"venous"},"FJ2658":{"id":"FJ2658","meshName":"FJ2658","label":"Tĩnh mạch gian thất trước","english":"Anterior interventricular vein","latin":"","note":"","sources":[{"title":"Giải phẫu học — giáo trình Y Hà Nội","page":223,"path":"medical_kb/text/giai-phau-yhn.txt","url":"/tai-lieu-y-khoa?file=Gi%E1%BA%A3i%20Ph%E1%BA%ABu%20Ng%C6%B0%E1%BB%9Di%20Y%20H%C3%A0%20N%E1%BB%99i%202006%20%C4%90%E1%BB%8F%20%C4%90en.pdf&page=223"}],"category":"venous"},"FJ2659":{"id":"FJ2659","meshName":"FJ2659","label":"Tĩnh mạch gian thất trước","english":"Anterior interventricular vein","latin":"","note":"","sources":[{"title":"Giải phẫu học — giáo trình Y Hà Nội","page":223,"path":"medical_kb/text/giai-phau-yhn.txt","url":"/tai-lieu-y-khoa?file=Gi%E1%BA%A3i%20Ph%E1%BA%ABu%20Ng%C6%B0%E1%BB%9Di%20Y%20H%C3%A0%20N%E1%BB%99i%202006%20%C4%90%E1%BB%8F%20%C4%90en.pdf&page=223"}],"category":"venous"},"FJ2660":{"id":"FJ2660","meshName":"FJ2660","label":"Tĩnh mạch gian thất trước","english":"Anterior interventricular vein","latin":"","note":"","sources":[{"title":"Giải phẫu học — giáo trình Y Hà Nội","page":223,"path":"medical_kb/text/giai-phau-yhn.txt","url":"/tai-lieu-y-khoa?file=Gi%E1%BA%A3i%20Ph%E1%BA%ABu%20Ng%C6%B0%E1%BB%9Di%20Y%20H%C3%A0%20N%E1%BB%99i%202006%20%C4%90%E1%BB%8F%20%C4%90en.pdf&page=223"}],"category":"venous"},"FJ2661":{"id":"FJ2661","meshName":"FJ2661","label":"Tĩnh mạch gian thất trước","english":"Anterior interventricular vein","latin":"","note":"","sources":[{"title":"Giải phẫu học — giáo trình Y Hà Nội","page":223,"path":"medical_kb/text/giai-phau-yhn.txt","url":"/tai-lieu-y-khoa?file=Gi%E1%BA%A3i%20Ph%E1%BA%ABu%20Ng%C6%B0%E1%BB%9Di%20Y%20H%C3%A0%20N%E1%BB%99i%202006%20%C4%90%E1%BB%8F%20%C4%90en.pdf&page=223"}],"category":"venous"},"FJ2662":{"id":"FJ2662","meshName":"FJ2662","label":"Tĩnh mạch gian thất trước","english":"Anterior interventricular vein","latin":"","note":"","sources":[{"title":"Giải phẫu học — giáo trình Y Hà Nội","page":223,"path":"medical_kb/text/giai-phau-yhn.txt","url":"/tai-lieu-y-khoa?file=Gi%E1%BA%A3i%20Ph%E1%BA%ABu%20Ng%C6%B0%E1%BB%9Di%20Y%20H%C3%A0%20N%E1%BB%99i%202006%20%C4%90%E1%BB%8F%20%C4%90en.pdf&page=223"}],"category":"venous"},"FJ2663":{"id":"FJ2663","meshName":"FJ2663","label":"Tĩnh mạch gian thất trước","english":"Anterior interventricular vein","latin":"","note":"","sources":[{"title":"Giải phẫu học — giáo trình Y Hà Nội","page":223,"path":"medical_kb/text/giai-phau-yhn.txt","url":"/tai-lieu-y-khoa?file=Gi%E1%BA%A3i%20Ph%E1%BA%ABu%20Ng%C6%B0%E1%BB%9Di%20Y%20H%C3%A0%20N%E1%BB%99i%202006%20%C4%90%E1%BB%8F%20%C4%90en.pdf&page=223"}],"category":"venous"},"FJ2664":{"id":"FJ2664","meshName":"FJ2664","label":"Tĩnh mạch gian thất trước","english":"Anterior interventricular vein","latin":"","note":"","sources":[{"title":"Giải phẫu học — giáo trình Y Hà Nội","page":223,"path":"medical_kb/text/giai-phau-yhn.txt","url":"/tai-lieu-y-khoa?file=Gi%E1%BA%A3i%20Ph%E1%BA%ABu%20Ng%C6%B0%E1%BB%9Di%20Y%20H%C3%A0%20N%E1%BB%99i%202006%20%C4%90%E1%BB%8F%20%C4%90en.pdf&page=223"}],"category":"venous"},"FJ2665":{"id":"FJ2665","meshName":"FJ2665","label":"Tĩnh mạch gian thất trước","english":"Anterior interventricular vein","latin":"","note":"","sources":[{"title":"Giải phẫu học — giáo trình Y Hà Nội","page":223,"path":"medical_kb/text/giai-phau-yhn.txt","url":"/tai-lieu-y-khoa?file=Gi%E1%BA%A3i%20Ph%E1%BA%ABu%20Ng%C6%B0%E1%BB%9Di%20Y%20H%C3%A0%20N%E1%BB%99i%202006%20%C4%90%E1%BB%8F%20%C4%90en.pdf&page=223"}],"category":"venous"}},"systems":[{"id":"skeletal","name":"Hệ xương","color":"#e2d9ba","description":"Xương tạo nên bộ khung nâng đỡ cơ thể, bảo vệ nội tạng và làm điểm bám cho cơ. Mô bên trong xương còn dự trữ khoáng chất và sinh ra tế bào máu."},{"id":"muscular","name":"Hệ cơ","color":"#a85b50","description":"Cơ vân sinh ra vận động bằng cách kéo vào các điểm bám. Cùng với gân, chúng làm cử động khớp, giữ tư thế và sinh nhiệt."},{"id":"cardiac","name":"Tim","color":"#b96760","description":"Tim là khối cơ bơm máu với bốn buồng. Các van tim hướng dòng máu đi một chiều qua vòng tuần hoàn phổi và vòng tuần hoàn hệ thống."},{"id":"sensory","name":"Cơ quan giác quan","color":"#b0c8ce","description":"Các cấu trúc đảm nhiệm những giác quan đặc biệt như thị giác, thính giác và thăng bằng. Mô chuyên biệt của chúng bắt kích thích rồi phối hợp với hệ thần kinh để truyền tin."},{"id":"arterial","name":"Động mạch","color":"#c05245","description":"Tim đẩy máu đi khắp vòng tuần hoàn. Động mạch dẫn máu rời tim để nuôi mô, riêng vòng tiểu tuần hoàn thì dẫn máu lên phổi."},{"id":"venous","name":"Tĩnh mạch","color":"#527c9f","description":"Tĩnh mạch đưa máu trở về tim. Mạng nông và mạng sâu gom máu từ các mô; tĩnh mạch phổi mang máu giàu oxy từ phổi về."},{"id":"nervous","name":"Hệ thần kinh","color":"#d8b565","description":"Não, tuỷ sống và dây thần kinh ngoại biên dẫn truyền và xử lý tín hiệu, đảm nhiệm cảm giác, vận động, phối hợp và điều hoà tự động các chức năng cơ thể."},{"id":"respiratory","name":"Hệ hô hấp","color":"#b98991","description":"Đường dẫn khí đưa không khí tới phổi, nơi oxy và carbon dioxide trao đổi giữa khí và máu. Hô hấp dựa vào chênh lệch áp suất do các cơ hô hấp tạo ra."},{"id":"digestive","name":"Hệ tiêu hoá","color":"#b8916b","description":"Ống tiêu hoá phân giải thức ăn, hấp thu dưỡng chất và nước rồi đẩy chất thải đi tiếp. Các tạng phụ thuộc góp mật và men tiêu hoá."},{"id":"urinary","name":"Hệ tiết niệu","color":"#b47961","description":"Thận lọc máu và điều hoà cân bằng dịch, điện giải, toan kiềm. Nước tiểu theo niệu quản xuống bàng quang rồi ra ngoài qua niệu đạo."},{"id":"lymphatic","name":"Hệ bạch huyết","color":"#879f7c","description":"Mạch bạch huyết đưa dịch mô dư thừa trở lại tuần hoàn. Hạch bạch huyết và các cơ quan lympho khác đảm nhiệm giám sát và đáp ứng miễn dịch."},{"id":"endocrine","name":"Hệ nội tiết","color":"#c5a09a","description":"Các tuyến nội tiết tiết hormone vào máu để điều phối những quá trình như chuyển hoá, tăng trưởng, đáp ứng stress và sinh sản."},{"id":"reproductive","name":"Hệ sinh dục","color":"#bda098","description":"Các cấu trúc sinh dục nam trong bộ dữ liệu này tham gia sinh tinh, làm tinh trùng trưởng thành, vận chuyển tinh trùng và sản xuất hormone sinh dục."},{"id":"integumentary","name":"Bề mặt cơ thể","color":"#ba9b7d","description":"Bề mặt cơ thể là mốc giải phẫu bên ngoài. Hệ da tạo hàng rào bảo vệ, góp phần vào cảm giác và điều hoà thân nhiệt."},{"id":"connective","name":"Mô liên kết","color":"#aec3bb","description":"Sụn, dây chằng và các mô liên kết khác nâng đỡ, nối và ngăn cách các cấu trúc. Chúng giữ vững khớp và phân tán tải cơ học."}],"atlasPath":"data:application/json;base64,","resourceBase":"https://offline.soma.local/api/mobile/viewer/bo-phan-tim"},"buffers":{"scene.bin.gz":"67414decb9cffc606abf0a13"}}