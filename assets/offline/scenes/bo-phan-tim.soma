","meshName":"FJ2654","label":"Nhánh mũ (LCx) — Circumflex branch of left coronary artery","english":"Circumflex branch of left coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2667":{"id":"FJ2667","meshName":"FJ2667","label":"Động mạch vành phải và nhánh bờ — Marginal branch of right coronary artery","english":"Marginal branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2668":{"id":"FJ2668","meshName":"FJ2668","label":"Động mạch vành phải và nhánh bờ — Marginal branch of right coronary artery","english":"Marginal branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2671":{"id":"FJ2671","meshName":"FJ2671","label":"Động mạch vành phải và nhánh bờ — First anterior ventricular branch of right coronary artery","english":"First anterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2672":{"id":"FJ2672","meshName":"FJ2672","label":"Động mạch vành phải và nhánh bờ — Marginal branch of right coronary artery","english":"Marginal branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2673":{"id":"FJ2673","meshName":"FJ2673","label":"Động mạch vành phải và nhánh bờ — First anterior ventricular branch of right coronary artery","english":"First anterior ventricular branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2674":{"id":"FJ2674","meshName":"FJ2674","label":"Động mạch vành phải và nhánh bờ — Marginal branch of right coronary artery","english":"Marginal branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2675":{"id":"FJ2675","meshName":"FJ2675","label":"Động mạch vành phải và nhánh bờ — Marginal branch of right coronary artery","english":"Marginal branch of right coronary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2677":{"id":"FJ2677","meshName":"FJ2677","label":"