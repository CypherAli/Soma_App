{"config":{"model":{"id":"bo-phan-tim","kind":"atlas","title":"Tim — học theo lớp","english":"The Heart — Layer by Layer","description":"Mở ra là bốn buồng tim và vách tim, cùng mạch vành nằm trên mặt tim. Bấm từng buồng trong danh sách để làm nổi và đọc ghi chú, hoặc bật Mặt cắt để nhìn vào lòng buồng. Bật lớp Van để thấy bốn van. Bật lớp Mạch lớn để thấy động mạch chủ, thân động mạch phổi (máu nghèo oxy, tô xanh) và tĩnh mạch phổi (máu giàu oxy, tô đỏ). Tắt lớp Mạch vành nếu muốn nhìn riêng hình dạng các buồng.","system":"cardiovascular","modelPath":"/mobile/assets/c2135be77ec9aa9ad9faf44d.json","viewerPath":"/mobile/viewer/bo-phan-tim","structures":[{"id":"nhi-phai","meshName":"nhi-phai","meshNames":["FJ2424","FJ2439"],"label":"Tâm nhĩ phải","english":"Right atrium","latin":"Atrium dextrum","note":"Nhận máu nghèo oxy từ tĩnh mạch chủ trên và dưới đổ về, rồi xuống tâm thất phải qua van ba lá. Nút xoang nhĩ — máy tạo nhịp tự nhiên của tim — nằm trong thành buồng này."},{"id":"that-phai","meshName":"that-phai","meshNames":["FJ2423","FJ2419","FJ2430","FJ2437"],"label":"Tâm thất phải","english":"Right ventricle","latin":"Ventriculus dexter","note":"Bơm máu nghèo oxy vào thân động mạch phổi. Thành mỏng hơn thất trái vì chỉ phải thắng sức cản thấp của vòng tiểu tuần hoàn. Ba cơ nhú kéo giữ lá van ba lá."},{"id":"nhi-trai","meshName":"nhi-trai","meshNames":["FJ2425","FJ2438"],"label":"Tâm nhĩ trái","english":"Left atrium","latin":"Atrium sinistrum","note":"Nhận máu giàu oxy từ bốn tĩnh mạch phổi, đổ xuống tâm thất trái qua van hai lá. Thành mỏng vì chỉ đẩy máu một quãng ngắn."},{"id":"that-trai","meshName":"that-trai","meshNames":["FJ2422","FJ2418","FJ2429"],"label":"Tâm thất trái","english":"Left ventricle","latin":"Ventriculus sinister","note":"Buồng bơm chính của cơ thể. Thành dày gấp nhiều lần thất phải vì phải tạo áp lực đẩy máu đi khắp vòng tuần hoàn hệ thống. Cơ nhú bên giữ lá van hai lá."},{"id":"thanh-that","meshName":"thanh-that","meshNames":["FJ2428"],"label":"Thành cơ thất","english":"Ventricular myocardium","latin":"Myocardium ventriculare","note":"Khối cơ tim bao cả hai thất — trong bộ dữ liệu này hai thất dùng CHUNG một khối thành, không tách riêng được. Bật mặt cắt lát ngang sẽ thấy rõ chênh lệch bề dày giữa hai bên."},{"id":"van-ba-la","meshName":"van-ba-la","meshNames":["FJ2421","FJ2433","FJ2436"],"label":"Van ba lá","english":"Tricuspid valve","latin":"Valva tricuspidalis","note":"Ngăn tâm nhĩ phải với tâm thất phải, gồm lá trước, lá sau và lá vách. Đóng khi thất co để máu không trào ngược lên nhĩ."},{"id":"van-hai-la","meshName":"van-hai-la","meshNames":["FJ2420","FJ2432"],"label":"Van hai lá","english":"Mitral valve","latin":"Valva mitralis","note":"Ngăn tâm nhĩ trái với tâm thất trái, chỉ có lá trước và lá sau — tên \"hai lá\" từ đó mà ra."},{"id":"van-dm-phoi","meshName":"van-dm-phoi","meshNames":["FJ2417","FJ2427","FJ2434"],"label":"Van động mạch phổi","english":"Pulmonary valve","latin":"Valva trunci pulmonalis","note":"Ba cánh bán nguyệt ở lối ra của thất phải. Mở khi thất co, đóng khi thất giãn để máu không chảy ngược về thất."},{"id":"van-dm-chu","meshName":"van-dm-chu","meshNames":["FJ2426","FJ2431","FJ2435"],"label":"Van động mạch chủ","english":"Aortic valve","latin":"Valva aortae","note":"Ba cánh bán nguyệt ở lối ra của thất trái. Ngay trên van này là lỗ xuất phát của hai động mạch vành."},{"id":"than-dm-phoi","meshName":"than-dm-phoi","meshNames":["FJ2924","FJ2966","FJ3019"],"label":"Thân và động mạch phổi","english":"Pulmonary trunk and arteries","latin":"Truncus pulmonalis","note":"ĐỘNG mạch nhưng mang máu NGHÈO oxy — ngoại lệ của quy tắc \"động mạch đỏ\". Thất phải bơm vào thân động mạch phổi, chia đôi lên hai phổi."},{"id":"tm-phoi","meshName":"tm-phoi","meshNames":["FJ2925","FJ2933","FJ2944","FJ2950","FJ2955","FJ3020","FJ3040"],"label":"Tĩnh mạch phổi","english":"Pulmonary veins","latin":"Venae pulmonales","note":"TĨNH mạch nhưng mang máu GIÀU oxy — ngoại lệ còn lại. Bốn tĩnh mạch phổi đưa máu đã trao đổi khí về tâm nhĩ trái."},{"id":"dm-chu","meshName":"dm-chu","meshNames":["FJ3411","FJ3413"],"label":"Động mạch chủ","english":"Aorta","latin":"Aorta","note":"Máu giàu oxy rời thất trái qua động mạch chủ lên, vòng qua quai động mạch chủ rồi đi nuôi toàn thân."},{"id":"dm-vanh","meshName":"dm-vanh","meshNames":["FJ2631","FJ2632","FJ2633","FJ2634","FJ2635","FJ2636","FJ2637","FJ2638","FJ2639","FJ2640","FJ2641","FJ2642","FJ2643","FJ2644","FJ2645","FJ2646","FJ2647","FJ2648","FJ2649","FJ2650","FJ2651","FJ2652","FJ2653","FJ2654","FJ2667","FJ2668","FJ2671","FJ2672","FJ2673","FJ2674","FJ2675","FJ2677","FJ2692","FJ2693","FJ2694","FJ2695","FJ2696","FJ2697","FJ2698","FJ2699","FJ2700","FJ2714","FJ2715","FJ2716","FJ2717","FJ2718","FJ2719","FJ2720","FJ2721","FJ2722","FJ2723","FJ2737"],"label":"Động mạch vành","english":"Coronary arteries","latin":"Arteriae coronariae","note":"Tim tự nuôi mình bằng hai động mạch vành tách ra ngay trên van động mạch chủ. Tắc nhánh liên thất trước (LAD) chạy dọc rãnh gian thất trước gây nhồi máu thành trước."},{"id":"tm-vanh","meshName":"tm-vanh","meshNames":["FJ2655","FJ2656","FJ2657","FJ2658","FJ2659","FJ2660","FJ2661","FJ2662","FJ2663","FJ2664","FJ2665"],"label":"Tĩnh mạch vành và xoang vành","english":"Cardiac veins and coronary sinus","latin":"Sinus coronarius","note":"Máu nuôi cơ tim gom về tĩnh mạch tim lớn rồi xoang vành, đổ thẳng vào tâm nhĩ phải."}],"thumbnailPath":"/mobile/assets/8ed81ac25b54dbe6bcef7853.jpg","attribution":"BodyParts3D 4.0 © Database Center for Life Science · CC BY 4.0. Nội dung và thuật ngữ: thư viện Soma."},"dark":false,"scene":{"slug":"bo-phan-tim","title":{"vi":"Tim — học theo lớp","en":"The Heart — Layer by Layer","zh":"心——分层学习"},"latin":"Cor","system":"cardiovascular","intro":{"vi":"Mở ra là bốn buồng tim và vách tim, cùng mạch vành nằm trên mặt tim. Bấm từng buồng trong danh sách để làm nổi và đọc ghi chú, hoặc bật Mặt cắt để nhìn vào lòng buồng. Bật lớp Van để thấy bốn van. Bật lớp Mạch lớn để thấy động mạch chủ, thân động mạch phổi (máu nghèo oxy, tô xanh) và tĩnh mạch phổi (máu giàu oxy, tô đỏ). Tắt lớp Mạch vành nếu muốn nhìn riêng hình dạng các buồng.","en":"It opens on the four chambers and the septum, with the coronary vessels on the surface. Tap a chamber in the list to highlight it and read its note, or turn on Section to look inside. Turn on Valves for the four valves. Turn on Great vessels for the aorta, the pulmonary trunk (deoxygenated, blue) and the pulmonary veins (oxygenated, red). Turn off Coronary vessels to see the chambers' shape alone.","zh":"打开时显示四个心腔和间隔，以及心表面的冠状血管。点击列表中的心腔可高亮并阅读注释，或开启“剖面”查看腔内。开启“瓣膜”可见四个瓣膜；开启“大血管”可见主动脉、肺动脉干（缺氧血，蓝色）和肺静脉（含氧血，红色）。关闭“冠状血管”可单独观察心腔形态。"},"layers":[{"key":"buong","name":{"vi":"Buồng tim","en":"Chambers","zh":"心腔"},"groups":["nhi-phai","that-phai","nhi-trai","that-trai","thanh-that"],"on":true},{"key":"van","name":{"vi":"Van tim","en":"Valves","zh":"瓣膜"},"groups":["van-ba-la","van-hai-la","van-dm-phoi","van-dm-chu"]},{"key":"mach-lon","name":{"vi":"Mạch lớn","en":"Great vessels","zh":"大血管"},"groups":["than-dm-phoi","tm-phoi","dm-chu"]},{"key":"vanh","name":{"vi":"Mạch vành","en":"Coronary vessels","zh":"冠状血管"},"groups":["dm-vanh","tm-vanh"],"on":true}],"groups":[{"key":"nhi-phai","name":{"vi":"Tâm nhĩ phải","en":"Right atrium","zh":"右心房"},"latin":"Atrium dextrum","note":{"vi":"Nhận máu nghèo oxy từ tĩnh mạch chủ trên và dưới đổ về, rồi xuống tâm thất phải qua van ba lá. Nút xoang nhĩ — máy tạo nhịp tự nhiên của tim — nằm trong thành buồng này.","en":"Receives oxygen-poor blood from the superior and inferior vena cava, then passes it to the right ventricle through the tricuspid valve. The sinoatrial node, the heart's natural pacemaker, sits in this chamber's wall.","zh":"接收来自上、下腔静脉的低氧血，经三尖瓣流入右心室。心脏的天然起搏点窦房结即位于此腔壁内。"},"tint":"#527c9f","parts":["FJ2424","FJ2439"]},{"key":"that-phai","name":{"vi":"Tâm thất phải","en":"Right ventricle","zh":"右心室"},"latin":"Ventriculus dexter","note":{"vi":"Bơm máu nghèo oxy vào thân động mạch phổi. Thành mỏng hơn thất trái vì chỉ phải thắng sức cản thấp của vòng tiểu tuần hoàn. Ba cơ nhú kéo giữ lá van ba lá.","en":"Pumps oxygen-poor blood into the pulmonary trunk. Its wall is thinner than the left ventricle because it only has to overcome the low resistance of the pulmonary circuit. Three papillary muscles anchor the tricuspid leaflets.","zh":"将低氧血泵入肺动脉干。因只需克服肺循环的低阻力，其室壁较左心室薄。三块乳头肌牵拉固定三尖瓣叶。"},"tint":"#527c9f","parts":["FJ2423","FJ2419","FJ2430","FJ2437"]},{"key":"nhi-trai","name":{"vi":"Tâm nhĩ trái","en":"Left atrium","zh":"左心房"},"latin":"Atrium sinistrum","note":{"vi":"Nhận máu giàu oxy từ bốn tĩnh mạch phổi, đổ xuống tâm thất trái qua van hai lá. Thành mỏng vì chỉ đẩy máu một quãng ngắn.","en":"Receives oxygen-rich blood from the four pulmonary veins and passes it to the left ventricle through the mitral valve. Its wall is thin because it only moves blood a short distance.","zh":"接收四条肺静脉回流的富氧血，经二尖瓣流入左心室。因输送距离短，房壁较薄。"},"tint":"#c05245","parts":["FJ2425","FJ2438"]},{"key":"that-trai","name":{"vi":"Tâm thất trái","en":"Left ventricle","zh":"左心室"},"latin":"Ventriculus sinister","note":{"vi":"Buồng bơm chính của cơ thể. Thành dày gấp nhiều lần thất phải vì phải tạo áp lực đẩy máu đi khắp vòng tuần hoàn hệ thống. Cơ nhú bên giữ lá van hai lá.","en":"The body's main pumping chamber. Its wall is several times thicker than the right ventricle because it must generate the pressure that drives blood through the systemic circulation. The lateral papillary muscle anchors the mitral leaflets.","zh":"全身主要的泵血腔。因需产生驱动体循环的压力，室壁厚度为右心室的数倍。外侧乳头肌固定二尖瓣叶。"},"tint":"#c05245","parts":["FJ2422","FJ2418","FJ2429"]},{"key":"thanh-that","name":{"vi":"Thành cơ thất","en":"Ventricular myocardium","zh":"心室肌壁"},"latin":"Myocardium ventriculare","note":{"vi":"Khối cơ tim bao cả hai thất — trong bộ dữ liệu này hai thất dùng CHUNG một khối thành, không tách riêng được. Bật mặt cắt lát ngang sẽ thấy rõ chênh lệch bề dày giữa hai bên.","en":"The muscle mass enclosing both ventricles. In this dataset the two ventricles SHARE a single wall mesh and cannot be separated. Turn on the transverse cross-section to see the difference in wall thickness between the two sides.","zh":"包绕两个心室的心肌整体。本数据集中两室共用同一壁网格，无法单独分离。开启横断切面即可看清两侧壁厚差异。"},"parts":["FJ2428"]},{"key":"van-ba-la","name":{"vi":"Van ba lá","en":"Tricuspid valve","zh":"三尖瓣"},"latin":"Valva tricuspidalis","note":{"vi":"Ngăn tâm nhĩ phải với tâm thất phải, gồm lá trước, lá sau và lá vách. Đóng khi thất co để máu không trào ngược lên nhĩ.","en":"Separates the right atrium from the right ventricle; it has an anterior, a posterior and a septal leaflet. It closes during ventricular contraction so blood cannot flow back into the atrium.","zh":"分隔右心房与右心室，由前叶、后叶和隔叶组成。心室收缩时关闭，防止血液反流入心房。"},"parts":["FJ2421","FJ2433","FJ2436"]},{"key":"van-hai-la","name":{"vi":"Van hai lá","en":"Mitral valve","zh":"二尖瓣"},"latin":"Valva mitralis","note":{"vi":"Ngăn tâm nhĩ trái với tâm thất trái, chỉ có lá trước và lá sau — tên \"hai lá\" từ đó mà ra.","en":"Separates the left atrium from the left ventricle. It has only an anterior and a posterior leaflet, which is where the name \"bicuspid\" comes from.","zh":"分隔左心房与左心室，仅有前叶与后叶两片瓣叶，故又称二尖瓣。"},"parts":["FJ2420","FJ2432"]},{"key":"van-dm-phoi","name":{"vi":"Van động mạch phổi","en":"Pulmonary valve","zh":"肺动脉瓣"},"latin":"Valva trunci pulmonalis","note":{"vi":"Ba cánh bán nguyệt ở lối ra của thất phải. Mở khi thất co, đóng khi thất giãn để máu không chảy ngược về thất.","en":"Three semilunar cusps at the outflow of the right ventricle. They open as the ventricle contracts and close as it relaxes, preventing backflow into the ventricle.","zh":"位于右心室流出道的三个半月瓣。心室收缩时开放，舒张时关闭，防止血液反流回心室。"},"parts":["FJ2417","FJ2427","FJ2434"]},{"key":"van-dm-chu","name":{"vi":"Van động mạch chủ","en":"Aortic valve","zh":"主动脉瓣"},"latin":"Valva aortae","note":{"vi":"Ba cánh bán nguyệt ở lối ra của thất trái. Ngay trên van này là lỗ xuất phát của hai động mạch vành.","en":"Three semilunar cusps at the outflow of the left ventricle. The openings of the two coronary arteries lie just above this valve.","zh":"位于左心室流出道的三个半月瓣。两条冠状动脉的开口就在此瓣上方。"},"parts":["FJ2426","FJ2431","FJ2435"]},{"key":"than-dm-phoi","name":{"vi":"Thân và động mạch phổi","en":"Pulmonary trunk and arteries","zh":"肺动脉干及肺动脉"},"latin":"Truncus pulmonalis","note":{"vi":"ĐỘNG mạch nhưng mang máu NGHÈO oxy — ngoại lệ của quy tắc \"động mạch đỏ\". Thất phải bơm vào thân động mạch phổi, chia đôi lên hai phổi.","en":"An ARTERY that carries oxygen-POOR blood — the exception to the \"arteries are red\" rule. The right ventricle pumps into the pulmonary trunk, which divides to reach both lungs.","zh":"虽为动脉却输送低氧血，是动脉即红色这一规则的例外。右心室将血液泵入肺动脉干，再分为左右两支进入双肺。"},"tint":"#527c9f","parts":["FJ2924","FJ2966","FJ3019"]},{"key":"tm-phoi","name":{"vi":"Tĩnh mạch phổi","en":"Pulmonary veins","zh":"肺静脉"},"latin":"Venae pulmonales","note":{"vi":"TĨNH mạch nhưng mang máu GIÀU oxy — ngoại lệ còn lại. Bốn tĩnh mạch phổi đưa máu đã trao đổi khí về tâm nhĩ trái.","en":"VEINS that carry oxygen-RICH blood — the other exception. Four pulmonary veins return freshly oxygenated blood to the left atrium.","zh":"虽为静脉却输送富氧血，是另一个例外。四条肺静脉将完成气体交换的血液送回左心房。"},"tint":"#c05245","parts":["FJ2925","FJ2933","FJ2944","FJ2950","FJ2955","FJ3020","FJ3040"]},{"key":"dm-chu","name":{"vi":"Động mạch chủ","en":"Aorta","zh":"主动脉"},"latin":"Aorta","note":{"vi":"Máu giàu oxy rời thất trái qua động mạch chủ lên, vòng qua quai động mạch chủ rồi đi nuôi toàn thân.","en":"Oxygen-rich blood leaves the left ventricle through the ascending aorta, curves around the aortic arch and travels on to supply the whole body.","zh":"富氧血自左心室经升主动脉射出，绕过主动脉弓后输送至全身。"},"parts":["FJ3411","FJ3413"]},{"key":"dm-vanh","name":{"vi":"Động mạch vành","en":"Coronary arteries","zh":"冠状动脉"},"latin":"Arteriae coronariae","note":{"vi":"Tim tự nuôi mình bằng hai động mạch vành tách ra ngay trên van động mạch chủ. Tắc nhánh liên thất trước (LAD) chạy dọc rãnh gian thất trước gây nhồi máu thành trước.","en":"The heart feeds itself through two coronary arteries arising just above the aortic valve. Occlusion of the left anterior descending branch, which runs along the anterior interventricular groove, causes an anterior wall infarction.","zh":"心脏依靠主动脉瓣上方发出的两条冠状动脉自我供血。走行于前室间沟的前降支闭塞可导致前壁心肌梗死。"},"parts":["FJ2631","FJ2632","FJ2633","FJ2634","FJ2635","FJ2636","FJ2637","FJ2638","FJ2639","FJ2640","FJ2641","FJ2642","FJ2643","FJ2644","FJ2645","FJ2646","FJ2647","FJ2648","FJ2649","FJ2650","FJ2651","FJ2652","FJ2653","FJ2654","FJ2667","FJ2668","FJ2671","FJ2672","FJ2673","FJ2674","FJ2675","FJ2677","FJ2692","FJ2693","FJ2694","FJ2695","FJ2696","FJ2697","FJ2698","FJ2699","FJ2700","FJ2714","FJ2715","FJ2716","FJ2717","FJ2718","FJ2719","FJ2720","FJ2721","FJ2722","FJ2723","FJ2737"]},{"key":"tm-vanh","name":{"vi":"Tĩnh mạch vành và xoang vành","en":"Cardiac veins and coronary sinus","zh":"心静脉与冠状窦"},"latin":"Sinus coronarius","note":{"vi":"Máu nuôi cơ tim gom về tĩnh mạch tim lớn rồi xoang vành, đổ thẳng vào tâm nhĩ phải.","en":"Blood that has supplied the myocardium collects into the great cardiac vein and then the coronary sinus, which drains directly into the right atrium.","zh":"营养心肌后的血液汇入心大静脉，再经冠状窦直接回流入右心房。"},"parts":["FJ2655","FJ2656","FJ2657","FJ2658","FJ2659","FJ2660","FJ2661","FJ2662","FJ2663","FJ2664","FJ2665"]}],"replacement":{"modelFile":"","hotspots":[]}},"parts":{"FJ2424":{"id":"FJ2424","meshName":"FJ2424","label":"Tâm nhĩ phải — Cavity of right atrium","english":"Cavity of right atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2439":{"id":"FJ2439","meshName":"FJ2439","label":"Tâm nhĩ phải — Wall of right atrium","english":"Wall of right atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2423":{"id":"FJ2423","meshName":"FJ2423","label":"Tâm thất phải — Cavity of right ventricle","english":"Cavity of right ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2419":{"id":"FJ2419","meshName":"FJ2419","label":"Cơ nhú · phải","english":"Anterior papillary muscle of right ventricle","latin":"Musculus papillaris","note":"Các trụ cơ nhô từ thành thất, nối với bờ lá van bằng dây chằng gân. Chúng co CÙNG LÚC với thất để căng dây chằng, giữ lá van không lộn ngược lên nhĩ. Nhồi máu cơ tim làm đứt cơ nhú gây hở van cấp tính và phù phổi tối cấp.","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (tim-day-du/papillary)"}],"category":"cardiac"},"FJ2430":{"id":"FJ2430","meshName":"FJ2430","label":"Tâm thất phải — Posterior papillary muscle of right ventricle","english":"Posterior papillary muscle of right ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2437":{"id":"FJ2437","meshName":"FJ2437","label":"Tâm thất phải — Septal papillary muscle of right ventricle","english":"Septal papillary muscle of right ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2425":{"id":"FJ2425","meshName":"FJ2425","label":"Tâm nhĩ trái — Cavity of left atrium","english":"Cavity of left atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2438":{"id":"FJ2438","meshName":"FJ2438","label":"Tâm nhĩ trái — Wall of left atrium","english":"Wall of left atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2422":{"id":"FJ2422","meshName":"FJ2422","label":"Tâm thất trái — Cavity of left ventricle","english":"Cavity of left ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2418":{"id":"FJ2418","meshName":"FJ2418","label":"Tâm thất trái — Anterolateral head of lateral papillary muscle of left ventricle","english":"Anterolateral head of lateral papillary muscle of left ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2429":{"id":"FJ2429","meshName":"FJ2429","label":"Tâm thất trái — Lateral papillary muscle of left ventricle","english":"Lateral papillary muscle of left ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2428":{"id":"FJ2428","meshName":"FJ2428","label":"Thành cơ thất","english":"Wall of ventricle","latin":"Myocardium ventriculare","note":"Khối cơ tim bao cả hai thất — trong bộ dữ liệu này hai thất dùng CHUNG một khối thành, không tách riêng được. Bật mặt cắt lát ngang sẽ thấy rõ chênh lệch bề dày giữa hai bên.","sources":[{"title":"Bài giải phẫu Soma","path":"src/lib/humanAtlas/scenes (giai-phau-tim/thanh-that)","url":"/giai-phau/mo-hinh/giai-phau-tim?focus=thanh-that"}],"category":"cardiac"},"FJ2421":{"id":"FJ2421","meshName":"FJ2421","label":"Van ba lá — Anterior leaflet of tricuspid valve","english":"Anterior leaflet of tricuspid valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2433":{"id":"FJ2433","meshName":"FJ2433","label":"Van ba lá — Posterior leaflet of tricuspid valve","english":"Posterior leaflet of tricuspid valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2436":{"id":"FJ2436","meshName":"FJ2436","label":"Van ba lá — Septal leaflet of tricuspid valve","english":"Septal leaflet of tricuspid valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2420":{"id":"FJ2420","meshName":"FJ2420","label":"Van hai lá — Anterior leaflet of mitral valve","english":"Anterior leaflet of mitral valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2432":{"id":"FJ2432","meshName":"FJ2432","label":"Van hai lá — Posterior leaflet of mitral valve","english":"Posterior leaflet of mitral valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2417":{"id":"FJ2417","meshName":"FJ2417","label":"Van động mạch phổi — Left anterior cusp of pulmonary valve","english":"Left anterior cusp of pulmonary valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2427":{"id":"FJ2427","meshName":"FJ2427","label":"Van động mạch phổi — Posterior cusp of pulmonary valve","english":"Posterior cusp of pulmonary valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2434":{"id":"FJ2434","meshName":"FJ2434","label":"Van động mạch phổi — Right anterior cusp of pulmonary valve","english":"Right anterior cusp of pulmonary valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2426":{"id":"FJ2426","meshName":"FJ2426","label":"Van động mạch chủ — Left posterior cusp of aortic valve","english":"Left posterior cusp of aortic valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2431":{"id":"FJ2431","meshName":"FJ2431","label":"Van động mạch chủ — Right posterior cusp of aortic valve","english":"Right posterior cusp of aortic valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2435":{"id":"FJ2435","meshName":"FJ2435","label":"Van động mạch chủ — Anterior cusp of aortic valve","english":"Anterior cusp of aortic valve","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2924":{"id":"FJ2924","meshName":"FJ2924","label":"Thân và động mạch phổi — Left pulmonary artery","english":"Left pulmonary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2966":{"id":"FJ2966","meshName":"FJ2966","label":"Thân động mạch phổi","english":"Pulmonary trunk","latin":"Truncus pulmonalis","note":"Mạch máu duy nhất mang máu NGHÈO oxy nhưng lại là ĐỘNG MẠCH (định nghĩa động/tĩnh mạch dựa vào chiều rời/về tim, không phải hàm lượng oxy) — tách đôi thành động mạch phổi trái và phải ngay sau khi rời tâm thất phải.","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (giai-phau-tim/pulmonary-trunk)"}],"category":"arterial"},"FJ3019":{"id":"FJ3019","meshName":"FJ3019","label":"Thân và động mạch phổi — Right pulmonary artery","english":"Right pulmonary artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ2925":{"id":"FJ2925","meshName":"FJ2925","label":"Tĩnh mạch phổi — Left superior pulmonary vein","english":"Left superior pulmonary vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2933":{"id":"FJ2933","meshName":"FJ2933","label":"Tĩnh mạch phổi — Left superior pulmonary vein","english":"Left superior pulmonary vein","latin":"","note":"","sources":[]