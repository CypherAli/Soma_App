"id":"FJ3106","meshName":"FJ3106","label":"Động mạch gan — Medial inferior segmental hepatic artery","english":"Medial inferior segmental hepatic artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ3107":{"id":"FJ3107","meshName":"FJ3107","label":"Động mạch gan — Medial superior segmental hepatic artery","english":"Medial superior segmental hepatic artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ3114":{"id":"FJ3114","meshName":"FJ3114","label":"Động mạch gan — Posterior inferior segmental hepatic artery","english":"Posterior inferior segmental hepatic artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ3115":{"id":"FJ3115","meshName":"FJ3115","label":"Động mạch gan — Posterior superior segmental hepatic artery","english":"Posterior superior segmental hepatic artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ3116":{"id":"FJ3116","meshName":"FJ3116","label":"Động mạch gan — Posterior superior segmental hepatic artery","english":"Posterior superior segmental hepatic artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ3117":{"id":"FJ3117","meshName":"FJ3117","label":"Động mạch gan — Trunk of right hepatic artery","english":"Trunk of right hepatic artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ1867":{"id":"FJ1867","meshName":"FJ1867","label":"Tĩnh mạch gan — Tributary of middle hepatic vein","english":"Tributary of middle hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2414":{"id":"FJ2414","meshName":"FJ2414","label":"Tĩnh mạch gan — Middle hepatic vein","english":"Middle hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2415":{"id":"FJ2415","meshName":"FJ2415","label":"Tĩnh mạch gan — Left hepatic vein","english":"Left hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2416":{"id":"FJ2416","meshName":"FJ2416","label":"Tĩnh mạch gan — Right hepatic vein","english":"Right hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3083":{"id":"FJ3083","meshName":"FJ3083","label":"Tĩnh mạch gan — Anterior inferior segmental tributary of middle hepatic vein","english":"Anterior inferior segmental tributary of middle hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3084":{"id":"FJ3084","meshName":"FJ3084","label":"Tĩnh mạch gan — Medial inferior segmental tributary of middle hepatic vein","english":"Medial inferior segmental tributary of middle hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3085":{"id":"FJ3085","meshName":"FJ3085","label":"Tĩnh mạch gan — Medial inferior segmental tributary of middle hepatic vein","english":"Medial inferior segmental tributary of middle hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3086":{"id":"FJ3086","meshName":"FJ3086","label":"Tĩnh mạch gan — Anterior inferior segmental tributary of middle hepatic vein","english":"Anterior inferior segmental tributary of middle hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3097":{"id":"FJ3097","meshName":"FJ3097","label":"Tĩnh mạch gan — Lateral inferior segmental tributary of left hepatic vein","english":"Lateral inferior segmental tributary of left hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3098":{"id":"FJ3098","meshName":"FJ3098","label":"Tĩnh mạch gan — Lateral superior segmental tributary of left hepatic vein","english":"Lateral superior segmental tributary of left hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3099":{"id":"FJ3099","meshName":"FJ3099","label":"Tĩnh mạch gan — Lateral inferior segmental tributary of left hepatic vein","english":"Lateral inferior segmental tributary of left hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3100":{"id":"FJ3100","meshName":"FJ3100","label":"Tĩnh mạch gan — Lateral inferior segmental tributary of left hepatic vein","english":"Lateral inferior segmental tributary of left hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3101":{"id":"FJ3101","meshName":"FJ3101","label":"Tĩnh mạch gan — Medial superior segmental tributary of left hepatic vein","english":"Medial superior segmental tributary of left hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3118":{"id":"FJ3118","meshName":"FJ3118","label":"Tĩnh mạch gan — Posterior inferior segmental tributary of right hepatic vein","english":"Posterior inferior segmental tributary of right hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3119":{"id":"FJ3119","meshName":"FJ3119","label":"Tĩnh mạch gan — Posterior superior segmental tributary of right hepatic vein","english":"Posterior superior segmental tributary of right hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3120":{"id":"FJ3120","meshName":"FJ3120","label":"Tĩnh mạch gan — Posterior inferior segmental tributary of right hepatic vein","english":"Posterior inferior segmental tributary of right hepatic vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3121":{"id":"FJ3121","meshName":"FJ3121","label":"Tĩnh mạch gan — Anterior superior segmental tributary of right hepatic vein","english":"Anterior superior segmental tributary of right hepatic vein","latin":"","note":"","sources":[],"category":"venous"}},"systems":[{"id":"skeletal","name":"Hệ xương","color":"#e2d9ba","description":"Xương tạo nên bộ khung nâng đỡ cơ thể, bảo vệ nội tạng và làm điểm bám cho cơ. Mô bên trong xương còn dự trữ khoáng chất và sinh ra tế bào máu."},{"id":"muscular","name":"Hệ cơ","color":"#a85b50","description":"Cơ vân sinh ra vận động bằng cách kéo vào các điểm bám. Cùng với gân, chúng làm cử động khớp, giữ tư thế và sinh nhiệt."},{"id":"cardiac","name":"Tim","color":"#b96760","description":"Tim là khối cơ bơm máu với bốn buồng. Các van tim hướng dòng máu đi một chiều qua vòng tuần hoàn phổi và vòng tuần hoàn hệ thống."},{"id":"sensory","name":"Cơ quan giác quan","color":"#b0c8ce","description":"Các cấu trúc đảm nhiệm những giác quan đặc biệt như thị giác, thính giác và thăng bằng. Mô chuyên biệt của chúng bắt kích thích rồi phối hợp với hệ thần kinh để truyền tin."},{"id":"arterial","name":"Động mạch","color":"#c05245","description":"Tim đẩy máu đi khắp vòng tuần hoàn. Động mạch dẫn máu rời tim để nuôi mô, riêng vòng tiểu tuần hoàn thì dẫn máu lên phổi."},{"id":"venous","name":"Tĩnh mạch","color":"#527c9f","description":"Tĩnh mạch đưa máu trở về tim. Mạng nông và mạng sâu gom máu từ các mô; tĩnh mạch phổi mang máu giàu oxy từ phổi về."},{"id":"nervous","name":"Hệ thần kinh","color":"#d8b565","description":"Não, tuỷ sống và dây thần kinh ngoại biên dẫn truyền và xử lý tín hiệu, đảm nhiệm cảm giác, vận động, phối hợp và điều hoà tự động các chức năng cơ thể."},{"id":"respiratory","name":"Hệ hô hấp","color":"#b98991","description":"Đường dẫn khí đưa không khí tới phổi, nơi oxy và carbon dioxide trao đổi giữa khí và máu. Hô hấp dựa vào chênh lệch áp suất do các cơ hô hấp tạo ra."},{"id":"digestive","name":"Hệ tiêu hoá","color":"#b8916b","description":"Ống tiêu hoá phân giải thức ăn, hấp thu dưỡng chất và nước rồi đẩy chất thải đi tiếp. Các tạng phụ thuộc góp mật và men tiêu hoá."},{"id":"urinary","name":"Hệ tiết niệu","color":"#b47961","description":"Thận lọc máu và điều hoà cân bằng dịch, điện giải, toan kiềm. Nước tiểu theo niệu quản xuống bàng quang rồi ra ngoài qua niệu đạo."},{"id":"lymphatic","name":"Hệ bạch huyết","color":"#879f7c","description":"Mạch bạch huyết đưa dịch mô dư thừa trở lại tuần hoàn. Hạch bạch huyết và các cơ quan lympho khác đảm nhiệm giám sát và đáp ứng miễn dịch."},{"id":"endocrine","name":"Hệ nội tiết","color":"#c5a09a","description":"Các tuyến nội tiết tiết hormone vào máu để điều phối những quá trình như chuyển hoá, tăng trưởng, đáp ứng stress và sinh sản."},{"id":"reproductive","name":"Hệ sinh dục","color":"#bda098","description":"Các cấu trúc sinh dục nam trong bộ dữ liệu này tham gia sinh tinh, làm tinh trùng trưởng thành, vận chuyển tinh trùng và sản xuất hormone sinh dục."},{"id":"integumentary","name":"Bề mặt cơ thể","color":"#ba9b7d","description":"Bề mặt cơ thể là mốc giải phẫu bên ngoài. Hệ da tạo hàng rào bảo vệ, góp phần vào cảm giác và điều hoà thân nhiệt."},{"id":"connective","name":"Mô liên kết","color":"#aec3bb","description":"Sụn, dây chằng và các mô liên kết khác nâng đỡ, nối và ngăn cách các cấu trúc. Chúng giữ vững khớp và phân tán tải cơ học."}],"atlasPath":"data:application/json;base64,","resourceBase":"https://offline.soma.local/api/mobile/viewer/giai-phau-gan"},"buffers":{"scene.bin.gz":"6b0f45f8fe19162a54ad3a12"}}