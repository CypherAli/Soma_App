pical segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2524":{"id":"FJ2524","meshName":"FJ2524","label":"Thuỳ trên: đỉnh, sau, trước — Right apical segmental bronchial tree","english":"Right apical segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2525":{"id":"FJ2525","meshName":"FJ2525","label":"Thuỳ trên: đỉnh, sau, trước — Right apical segmental bronchial tree","english":"Right apical segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2526":{"id":"FJ2526","meshName":"FJ2526","label":"Thuỳ trên: đỉnh, sau, trước — Right apical segmental bronchial tree","english":"Right apical segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2527":{"id":"FJ2527","meshName":"FJ2527","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left posterior basal segmental bronchial tree","english":"Left posterior basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2528":{"id":"FJ2528","meshName":"FJ2528","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left posterior basal segmental bronchial tree","english":"Left posterior basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2529":{"id":"FJ2529","meshName":"FJ2529","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left posterior basal segmental bronchial tree","english":"Left posterior basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2530":{"id":"FJ2530","meshName":"FJ2530","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left posterior basal segmental bronchial tree","english":"Left posterior basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2531":{"id":"FJ2531","meshName":"FJ2531","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left posterior basal segmental bronchial tree","english":"Left posterior basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2532":{"id":"FJ2532","meshName":"FJ2532","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left lateral basal segmental bronchial tree","english":"Left lateral basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2533":{"id":"FJ2533","meshName":"FJ2533","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left lateral basal segmental bronchial tree","english":"Left lateral basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2534":{"id":"FJ2534","meshName":"FJ2534","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left lateral basal segmental bronchial tree","english":"Left lateral basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2535":{"id":"FJ2535","meshName":"FJ2535","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left anterior basal segmental bronchial tree","english":"Left anterior basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2536":{"id":"FJ2536","meshName":"FJ2536","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left anterior basal segmental bronchial tree","english":"Left anterior basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2537":{"id":"FJ2537","meshName":"FJ2537","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left medial basal segmental bronchial tree","english":"Left medial basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2538":{"id":"FJ2538","meshName":"FJ2538","label":"Thuỳ dưới: trên và bốn phân thùy nền — Left anterior basal segmental bronchial tree","english":"Left anterior basal segmental bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2539":{"id":"FJ2539","meshName":"FJ2539","label":"Khí quản · phải","english":"Right main bronchus proper","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2540":{"id":"FJ2540","meshName":"FJ2540","label":"Lưỡi phổi (trái): trên, dưới — Superior lingular bronchial tree","english":"Superior lingular bronchial tree","latin":"","note":"","sources":[],"category":"respiratory"},"FJ2541":{"id":"FJ2541","meshName":"FJ2541","label":"Khí quản","english":"Trachea","latin":"Trachea","note":"Ống dẫn khí trung tâm dài ~10-12cm, giữ mở nhờ 16-20 vòng sụn hình chữ C (hở ở mặt sau giáp thực quản). Chia đôi tại carina (ngang mức đốt sống ngực T4-T5) thành phế quản chính phải và trái.","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (giai-phau-phoi/trachea)"}],"category":"respiratory"}},"systems":[{"id":"skeletal","name":"Hệ xương","color":"#e2d9ba","description":"Xương tạo nên bộ khung nâng đỡ cơ thể, bảo vệ nội tạng và làm điểm bám cho cơ. Mô bên trong xương còn dự trữ khoáng chất và sinh ra tế bào máu."},{"id":"muscular","name":"Hệ cơ","color":"#a85b50","description":"Cơ vân sinh ra vận động bằng cách kéo vào các điểm bám. Cùng với gân, chúng làm cử động khớp, giữ tư thế và sinh nhiệt."},{"id":"cardiac","name":"Tim","color":"#b96760","description":"Tim là khối cơ bơm máu với bốn buồng. Các van tim hướng dòng máu đi một chiều qua vòng tuần hoàn phổi và vòng tuần hoàn hệ thống."},{"id":"sensory","name":"Cơ quan giác quan","color":"#b0c8ce","description":"Các cấu trúc đảm nhiệm những giác quan đặc biệt như thị giác, thính giác và thăng bằng. Mô chuyên biệt của chúng bắt kích thích rồi phối hợp với hệ thần kinh để truyền tin."},{"id":"arterial","name":"Động mạch","color":"#c05245","description":"Tim đẩy máu đi khắp vòng tuần hoàn. Động mạch dẫn máu rời tim để nuôi mô, riêng vòng tiểu tuần hoàn thì dẫn máu lên phổi."},{"id":"venous","name":"Tĩnh mạch","color":"#527c9f","description":"Tĩnh mạch đưa máu trở về tim. Mạng nông và mạng sâu gom máu từ các mô; tĩnh mạch phổi mang máu giàu oxy từ phổi về."},{"id":"nervous","name":"Hệ thần kinh","color":"#d8b565","description":"Não, tuỷ sống và dây thần kinh ngoại biên dẫn truyền và xử lý tín hiệu, đảm nhiệm cảm giác, vận động, phối hợp và điều hoà tự động các chức năng cơ thể."},{"id":"respiratory","name":"Hệ hô hấp","color":"#b98991","description":"Đường dẫn khí đưa không khí tới phổi, nơi oxy và carbon dioxide trao đổi giữa khí và máu. Hô hấp dựa vào chênh lệch áp suất do các cơ hô hấp tạo ra."},{"id":"digestive","name":"Hệ tiêu hoá","color":"#b8916b","description":"Ống tiêu hoá phân giải thức ăn, hấp thu dưỡng chất và nước rồi đẩy chất thải đi tiếp. Các tạng phụ thuộc góp mật và men tiêu hoá."},{"id":"urinary","name":"Hệ tiết niệu","color":"#b47961","description":"Thận lọc máu và điều hoà cân bằng dịch, điện giải, toan kiềm. Nước tiểu theo niệu quản xuống bàng quang rồi ra ngoài qua niệu đạo."},{"id":"lymphatic","name":"Hệ bạch huyết","color":"#879f7c","description":"Mạch bạch huyết đưa dịch mô dư thừa trở lại tuần hoàn. Hạch bạch huyết và các cơ quan lympho khác đảm nhiệm giám sát và đáp ứng miễn dịch."},{"id":"endocrine","name":"Hệ nội tiết","color":"#c5a09a","description":"Các tuyến nội tiết tiết hormone vào máu để điều phối những quá trình như chuyển hoá, tăng trưởng, đáp ứng stress và sinh sản."},{"id":"reproductive","name":"Hệ sinh dục","color":"#bda098","description":"Các cấu trúc sinh dục nam trong bộ dữ liệu này tham gia sinh tinh, làm tinh trùng trưởng thành, vận chuyển tinh trùng và sản xuất hormone sinh dục."},{"id":"integumentary","name":"Bề mặt cơ thể","color":"#ba9b7d","description":"Bề mặt cơ thể là mốc giải phẫu bên ngoài. Hệ da tạo hàng rào bảo vệ, góp phần vào cảm giác và điều hoà thân nhiệt."},{"id":"connective","name":"Mô liên kết","color":"#aec3bb","description":"Sụn, dây chằng và các mô liên kết khác nâng đỡ, nối và ngăn cách các cấu trúc. Chúng giữ vững khớp và phân tán tải cơ học."}],"atlasPath":"data:application/json;base64,","resourceBase":"https://offline.soma.local/api/mobile/viewer/mang-phoi"},"buffers":{"scene.bin.gz":"98e93c54ed0111af135282ab"}}