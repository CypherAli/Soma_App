in":"","note":"","sources":[],"category":"digestive"},"FJ2614":{"id":"FJ2614","meshName":"FJ2614","label":"Hỗng tràng đoạn giữa và xa — Distal part of jejunum","english":"Distal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2615":{"id":"FJ2615","meshName":"FJ2615","label":"Hỗng tràng đoạn giữa và xa — Distal part of jejunum","english":"Distal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2616":{"id":"FJ2616","meshName":"FJ2616","label":"Hỗng tràng đoạn giữa và xa — Distal part of jejunum","english":"Distal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2617":{"id":"FJ2617","meshName":"FJ2617","label":"Hỗng tràng đoạn gần — Proximal part of jejunum","english":"Proximal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2618":{"id":"FJ2618","meshName":"FJ2618","label":"Hỗng tràng đoạn giữa và xa — Distal part of jejunum","english":"Distal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2619":{"id":"FJ2619","meshName":"FJ2619","label":"Hỗng tràng đoạn giữa và xa — Distal part of jejunum","english":"Distal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2620":{"id":"FJ2620","meshName":"FJ2620","label":"Hỗng tràng đoạn giữa và xa — Distal part of jejunum","english":"Distal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2621":{"id":"FJ2621","meshName":"FJ2621","label":"Hỗng tràng đoạn giữa và xa — Distal part of jejunum","english":"Distal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2622":{"id":"FJ2622","meshName":"FJ2622","label":"Hỗng tràng đoạn gần — Proximal part of jejunum","english":"Proximal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2623":{"id":"FJ2623","meshName":"FJ2623","label":"Hỗng tràng đoạn gần — Proximal part of jejunum","english":"Proximal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2624":{"id":"FJ2624","meshName":"FJ2624","label":"Hỗng tràng đoạn gần — Proximal part of jejunum","english":"Proximal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2625":{"id":"FJ2625","meshName":"FJ2625","label":"Hỗng tràng đoạn gần — Proximal part of jejunum","english":"Proximal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2626":{"id":"FJ2626","meshName":"FJ2626","label":"Hỗng tràng đoạn gần — Proximal part of jejunum","english":"Proximal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2627":{"id":"FJ2627","meshName":"FJ2627","label":"Hỗng tràng đoạn gần — Proximal part of jejunum","english":"Proximal part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ2628":{"id":"FJ2628","meshName":"FJ2628","label":"Hỗng tràng đoạn giữa và xa — Middle part of jejunum","english":"Middle part of jejunum","latin":"","note":"","sources":[],"category":"digestive"},"FJ3396":{"id":"FJ3396","meshName":"FJ3396","label":"Dải cơ dọc và mạc treo ruột non — Mesentery of small intestine","english":"Mesentery of small intestine","latin":"","note":"","sources":[],"category":"digestive"},"FJ2565":{"id":"FJ2565","meshName":"FJ2565","label":"Ruột thừa và mạc treo — Appendix","english":"Appendix","latin":"","note":"","sources":[],"category":"digestive"},"FJ2566":{"id":"FJ2566","meshName":"FJ2566","label":"Đại tràng","english":"Ascending colon","latin":"Colon","note":"Tạo khung bao quanh ổ bụng (lên → ngang → xuống → xích-ma), hấp thu nước và tạo khuôn phân — xem chi tiết từng đoạn ở trang \"Đại tràng\".","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (tong-quan-he-tieu-hoa/colon-overview)"}],"category":"digestive"},"FJ2567":{"id":"FJ2567","meshName":"FJ2567","label":"Đại tràng xuống","english":"Descending colon","latin":"Colon descendens","note":"Cũng nằm sau phúc mạc, lòng hẹp hơn và phân đã đặc. Vì vậy ung thư đại tràng TRÁI hay gây tắc ruột và thay đổi thói quen đại tiện, khác hẳn kiểu biểu hiện của ung thư đại tràng phải.","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (ruot-non-ruot-gia/descending-colon)"}],"category":"digestive"},"FJ2568":{"id":"FJ2568","meshName":"FJ2568","label":"Dải cơ dọc và mạc treo ruột non — Taenia libera","english":"Taenia libera","latin":"","note":"","sources":[],"category":"digestive"},"FJ2569":{"id":"FJ2569","meshName":"FJ2569","label":"Dải cơ dọc và mạc treo ruột non — Taenia mesocolica","english":"Taenia mesocolica","latin":"","note":"","sources":[],"category":"digestive"},"FJ2570":{"id":"FJ2570","meshName":"FJ2570","label":"Dải cơ dọc và mạc treo ruột non — Taenia omentalis","english":"Taenia omentalis","latin":"","note":"","sources":[],"category":"digestive"},"FJ2571":{"id":"FJ2571","meshName":"FJ2571","label":"Trực tràng","english":"Rectum","latin":"Rectum","note":"Đoạn cuối ống tiêu hoá, nối đại tràng xích-ma với ống hậu môn, giãn nở chứa phân trước khi đại tiện. Nguồn: BodyParts3D — xem chi tiết ở trang \"Đại-trực tràng\".","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (tong-quan-he-tieu-hoa/rectum-overview)"}],"category":"digestive"},"FJ2572":{"id":"FJ2572","meshName":"FJ2572","label":"Đại tràng ngang","english":"Transverse colon","latin":"Colon transversum","note":"Đoạn đại tràng có MẠC TREO thật sự nên di động nhiều nhất, võng xuống có khi tới tận chậu hông. Ranh giới giữa vùng mạc treo tràng trên và tràng dưới nằm ở chỗ nối hai phần ba phải với một phần ba trái của đoạn này — mốc phôi thai giải thích cả kiểu đau: ruột giữa đau quanh rốn, ruột sau đau hạ vị.","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (mach-mac-treo/transverse-colon)"}],"category":"digestive"},"FJ3397":{"id":"FJ3397","meshName":"FJ3397","label":"Ruột thừa và mạc treo — Mesoappendix","english":"Mesoappendix","latin":"","note":"","sources":[],"category":"digestive"},"FJ3398":{"id":"FJ3398","meshName":"FJ3398","label":"Đại tràng ngang và mạc treo — Transverse mesocolon","english":"Transverse mesocolon","latin":"","note":"","sources":[],"category":"digestive"}},"systems":[{"id":"skeletal","name":"Hệ xương","color":"#e2d9ba","description":"Xương tạo nên bộ khung nâng đỡ cơ thể, bảo vệ nội tạng và làm điểm bám cho cơ. Mô bên trong xương còn dự trữ khoáng chất và sinh ra tế bào máu."},{"id":"muscular","name":"Hệ cơ","color":"#a85b50","description":"Cơ vân sinh ra vận động bằng cách kéo vào các điểm bám. Cùng với gân, chúng làm cử động khớp, giữ tư thế và sinh nhiệt."},{"id":"cardiac","name":"Tim","color":"#b96760","description":"Tim là khối cơ bơm máu với bốn buồng. Các van tim hướng dòng máu đi một chiều qua vòng tuần hoàn phổi và vòng tuần hoàn hệ thống."},{"id":"sensory","name":"Cơ quan giác quan","color":"#b0c8ce","description":"Các cấu trúc đảm nhiệm những giác quan đặc biệt như thị giác, thính giác và thăng bằng. Mô chuyên biệt của chúng bắt kích thích rồi phối hợp với hệ thần kinh để truyền tin."},{"id":"arterial","name":"Động mạch","color":"#c05245","description":"Tim đẩy máu đi khắp vòng tuần hoàn. Động mạch dẫn máu rời tim để nuôi mô, riêng vòng tiểu tuần hoàn thì dẫn máu lên phổi."},{"id":"venous","name":"Tĩnh mạch","color":"#527c9f","description":"Tĩnh mạch đưa máu trở về tim. Mạng nông và mạng sâu gom máu từ các mô; tĩnh mạch phổi mang máu giàu oxy từ phổi về."},{"id":"nervous","name":"Hệ thần kinh","color":"#d8b565","description":"Não, tuỷ sống và dây thần kinh ngoại biên dẫn truyền và xử lý tín hiệu, đảm nhiệm cảm giác, vận động, phối hợp và điều hoà tự động các chức năng cơ thể."},{"id":"respiratory","name":"Hệ hô hấp","color":"#b98991","description":"Đường dẫn khí đưa không khí tới phổi, nơi oxy và carbon dioxide trao đổi giữa khí và máu. Hô hấp dựa vào chênh lệch áp suất do các cơ hô hấp tạo ra."},{"id":"digestive","name":"Hệ tiêu hoá","color":"#b8916b","description":"Ống tiêu hoá phân giải thức ăn, hấp thu dưỡng chất và nước rồi đẩy chất thải đi tiếp. Các tạng phụ thuộc góp mật và men tiêu hoá."},{"id":"urinary","name":"Hệ tiết niệu","color":"#b47961","description":"Thận lọc máu và điều hoà cân bằng dịch, điện giải, toan kiềm. Nước tiểu theo niệu quản xuống bàng quang rồi ra ngoài qua niệu đạo."},{"id":"lymphatic","name":"Hệ bạch huyết","color":"#879f7c","description":"Mạch bạch huyết đưa dịch mô dư thừa trở lại tuần hoàn. Hạch bạch huyết và các cơ quan lympho khác đảm nhiệm giám sát và đáp ứng miễn dịch."},{"id":"endocrine","name":"Hệ nội tiết","color":"#c5a09a","description":"Các tuyến nội tiết tiết hormone vào máu để điều phối những quá trình như chuyển hoá, tăng trưởng, đáp ứng stress và sinh sản."},{"id":"reproductive","name":"Hệ sinh dục","color":"#bda098","description":"Các cấu trúc sinh dục nam trong bộ dữ liệu này tham gia sinh tinh, làm tinh trùng trưởng thành, vận chuyển tinh trùng và sản xuất hormone sinh dục."},{"id":"integumentary","name":"Bề mặt cơ thể","color":"#ba9b7d","description":"Bề mặt cơ thể là mốc giải phẫu bên ngoài. Hệ da tạo hàng rào bảo vệ, góp phần vào cảm giác và điều hoà thân nhiệt."},{"id":"connective","name":"Mô liên kết","color":"#aec3bb","description":"Sụn, dây chằng và các mô liên kết khác nâng đỡ, nối và ngăn cách các cấu trúc. Chúng giữ vững khớp và phân tán tải cơ học."}],"atlasPath":"data:application/json;base64,","resourceBase":"https://offline.soma.local/api/mobile/viewer/mach-mac-treo"},"buffers":{"scene.bin.gz":"10c27d17c949ae8785c3fa7b"}}