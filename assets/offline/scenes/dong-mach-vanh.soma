id":"FJ2729","meshName":"FJ2729","label":"Các tĩnh mạch tim khác — Right marginal vein","english":"Right marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2730":{"id":"FJ2730","meshName":"FJ2730","label":"Các tĩnh mạch tim khác — Anterior cardiac vein","english":"Anterior cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2731":{"id":"FJ2731","meshName":"FJ2731","label":"Các tĩnh mạch tim khác — Small cardiac vein","english":"Small cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2428":{"id":"FJ2428","meshName":"FJ2428","label":"Thành cơ thất","english":"Wall of ventricle","latin":"Myocardium ventriculare","note":"Khối cơ tim bao cả hai thất — trong bộ dữ liệu này hai thất dùng CHUNG một khối thành, không tách riêng được. Bật mặt cắt lát ngang sẽ thấy rõ chênh lệch bề dày giữa hai bên.","sources":[{"title":"Bài giải phẫu Soma","path":"src/lib/humanAtlas/scenes (giai-phau-tim/thanh-that)","url":"/giai-phau/mo-hinh/giai-phau-tim?focus=thanh-that"}],"category":"cardiac"},"FJ2438":{"id":"FJ2438","meshName":"FJ2438","label":"Tâm nhĩ trái — Wall of left atrium","english":"Wall of left atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2439":{"id":"FJ2439","meshName":"FJ2439","label":"Tâm nhĩ phải — Wall of right atrium","english":"Wall of right atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2966":{"id":"FJ2966","meshName":"FJ2966","label":"Thân động mạch phổi","english":"Pulmonary trunk","latin":"Truncus pulmonalis","note":"Mạch máu duy nhất mang máu NGHÈO oxy nhưng lại là ĐỘNG MẠCH (định nghĩa động/tĩnh mạch dựa vào chiều rời/về tim, không phải hàm lượng oxy) — tách đôi thành động mạch phổi trái và phải ngay sau khi rời tâm thất phải.","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (giai-phau-tim/pulmonary-trunk)"}],"category":"arterial"},"FJ3413":{"id":"FJ3413","meshName":"FJ3413","label":"Động mạch chủ — Ascending aorta","english":"Ascending aorta","latin":"","note":"","sources":[],"category":"arterial"}},"systems":[{"id":"skeletal","name":"Hệ xương","color":"#e2d9ba","description":"Xương tạo nên bộ khung nâng đỡ cơ thể, bảo vệ nội tạng và làm điểm bám cho cơ. Mô bên trong xương còn dự trữ khoáng chất và sinh ra tế bào máu."},{"id":"muscular","name":"Hệ cơ","color":"#a85b50","description":"Cơ vân sinh ra vận động bằng cách kéo vào các điểm bám. Cùng với gân, chúng làm cử động khớp, giữ tư thế và sinh nhiệt."},{"id":"cardiac","name":"Tim","color":"#b96760","description":"Tim là khối cơ bơm máu với bốn buồng. Các van tim hướng dòng máu đi một chiều qua vòng tuần hoàn phổi và vòng tuần hoàn hệ thống."},{"id":"sensory","name":"Cơ quan giác quan","color":"#b0c8ce","description":"Các cấu trúc đảm nhiệm những giác quan đặc biệt như thị giác, thính giác và thăng bằng. Mô chuyên biệt của chúng bắt kích thích rồi phối hợp với hệ thần kinh để truyền tin."},{"id":"arterial","name":"Động mạch","color":"#c05245","description":"Tim đẩy máu đi khắp vòng tuần hoàn. Động mạch dẫn máu rời tim để nuôi mô, riêng vòng tiểu tuần hoàn thì dẫn máu lên phổi."},{"id":"venous","name":"Tĩnh mạch","color":"#527c9f","description":"Tĩnh mạch đưa máu trở về tim. Mạng nông và mạng sâu gom máu từ các mô; tĩnh mạch phổi mang máu giàu oxy từ phổi về."},{"id":"nervous","name":"Hệ thần kinh","color":"#d8b565","description":"Não, tuỷ sống và dây thần kinh ngoại biên dẫn truyền và xử lý tín hiệu, đảm nhiệm cảm giác, vận động, phối hợp và điều hoà tự động các chức năng cơ thể."},{"id":"respiratory","name":"Hệ hô hấp","color":"#b98991","description":"Đường dẫn khí đưa không khí tới phổi, nơi oxy và carbon dioxide trao đổi giữa khí và máu. Hô hấp dựa vào chênh lệch áp suất do các cơ hô hấp tạo ra."},{"id":"digestive","name":"Hệ tiêu hoá","color":"#b8916b","description":"Ống tiêu hoá phân giải thức ăn, hấp thu dưỡng chất và nước rồi đẩy chất thải đi tiếp. Các tạng phụ thuộc góp mật và men tiêu hoá."},{"id":"urinary","name":"Hệ tiết niệu","color":"#b47961","description":"Thận lọc máu và điều hoà cân bằng dịch, điện giải, toan kiềm. Nước tiểu theo niệu quản xuống bàng quang rồi ra ngoài qua niệu đạo."},{"id":"lymphatic","name":"Hệ bạch huyết","color":"#879f7c","description":"Mạch bạch huyết đưa dịch mô dư thừa trở lại tuần hoàn. Hạch bạch huyết và các cơ quan lympho khác đảm nhiệm giám sát và đáp ứng miễn dịch."},{"id":"endocrine","name":"Hệ nội tiết","color":"#c5a09a","description":"Các tuyến nội tiết tiết hormone vào máu để điều phối những quá trình như chuyển hoá, tăng trưởng, đáp ứng stress và sinh sản."},{"id":"reproductive","name":"Hệ sinh dục","color":"#bda098","description":"Các cấu trúc sinh dục nam trong bộ dữ liệu này tham gia sinh tinh, làm tinh trùng trưởng thành, vận chuyển tinh trùng và sản xuất hormone sinh dục."},{"id":"integumentary","name":"Bề mặt cơ thể","color":"#ba9b7d","description":"Bề mặt cơ thể là mốc giải phẫu bên ngoài. Hệ da tạo hàng rào bảo vệ, góp phần vào cảm giác và điều hoà thân nhiệt."},{"id":"connective","name":"Mô liên kết","color":"#aec3bb","description":"Sụn, dây chằng và các mô liên kết khác nâng đỡ, nối và ngăn cách các cấu trúc. Chúng giữ vững khớp và phân tán tải cơ học."}],"atlasPath":"data:application/json;base64,","resourceBase":"https://offline.soma.local/api/mobile/viewer/dong-mach-vanh"},"buffers":{"scene.bin.gz":"1b0a95f0b036af4f2337d5e1"}}