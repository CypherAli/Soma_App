y":"venous"},"FJ2689":{"id":"FJ2689","meshName":"FJ2689","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2690":{"id":"FJ2690","meshName":"FJ2690","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2691":{"id":"FJ2691","meshName":"FJ2691","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2701":{"id":"FJ2701","meshName":"FJ2701","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2702":{"id":"FJ2702","meshName":"FJ2702","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2703":{"id":"FJ2703","meshName":"FJ2703","label":"Các tĩnh mạch tim khác — Left marginal vein","english":"Left marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2704":{"id":"FJ2704","meshName":"FJ2704","label":"Các tĩnh mạch tim khác — Left marginal vein","english":"Left marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2705":{"id":"FJ2705","meshName":"FJ2705","label":"Các tĩnh mạch tim khác — Left marginal vein","english":"Left marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2706":{"id":"FJ2706","meshName":"FJ2706","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2707":{"id":"FJ2707","meshName":"FJ2707","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2708":{"id":"FJ2708","mesh