"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2684":{"id":"FJ2684","meshName":"FJ2684","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2685":{"id":"FJ2685","meshName":"FJ2685","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2686":{"id":"FJ2686","meshName":"FJ2686","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2687":{"id":"FJ2687","meshName":"FJ2687","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2688":{"id":"FJ2688","meshName":"FJ2688","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2689":{"id":"FJ2689","meshName":"FJ2689","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2690":{"id":"FJ2690","meshName":"FJ2690","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2691":{"id":"FJ2691","meshName":"FJ2691","label":"Các tĩnh mạch tim khác — Middle cardiac vein","english":"Middle cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2701":{"id":"FJ2701","meshName":"FJ2701","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2702":{"id":"FJ2702","meshName":"FJ2702","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2703":{"id":"FJ2703","meshName":"FJ2703","label":"Các tĩnh mạch tim khác — Left marginal vein","english":"Left marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2704":{"id":"FJ2704","meshName":"FJ2704","label":"Các tĩnh mạch tim khác — Left marginal vein","english":"Left marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2705":{"id":"FJ2705","meshName":"FJ2705","label":"Các tĩnh mạch tim khác — Left marginal vein","english":"Left marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2706":{"id":"FJ2706","meshName":"FJ2706","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2707":{"id":"FJ2707","meshName":"FJ2707","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2708":{"id":"FJ2708","meshName":"FJ2708","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2709":{"id":"FJ2709","meshName":"FJ2709","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2710":{"id":"FJ2710","meshName":"FJ2710","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2711":{"id":"FJ2711","meshName":"FJ2711","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2712":{"id":"FJ2712","meshName":"FJ2712","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2713":{"id":"FJ2713","meshName":"FJ2713","label":"Các tĩnh mạch tim khác — Posterior vein of left ventricle","english":"Posterior vein of left ventricle","latin":"","note":"","sources":[],"category":"venous"},"FJ2724":{"id":"FJ2724","meshName":"FJ2724","label":"Các tĩnh mạch tim khác — Small cardiac vein","english":"Small cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2725":{"id":"FJ2725","meshName":"FJ2725","label":"Các tĩnh mạch tim khác — Anterior cardiac vein","english":"Anterior cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2727":{"id":"FJ2727","meshName":"FJ2727","label":"Các tĩnh mạch tim khác — Right marginal vein","english":"Right marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2728":{"id":"FJ2728","meshName":"FJ2728","label":"Các tĩnh mạch tim khác — Right marginal vein","english":"Right marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2729":{"id":"FJ2729","meshName":"FJ2729","label":"Các tĩnh mạch tim khác — Right marginal vein","english":"Right marginal vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2730":{"id":"FJ2730","meshName":"FJ2730","label":"Các tĩnh mạch tim khác — Anterior cardiac vein","english":"Anterior cardiac vein","latin":"","note":"","sources":[],"category":"venous"},"FJ2731":{"id":"FJ2731","meshName":"FJ2731","label":"Các tĩnh mạch tim khác — Small cardiac vein","english":"Small cardiac vein","latin":"","note":"","sources":[],"category":"venous"}},"systems":[{"id":"skeletal","name":"Hệ xương","color":"#e2d9ba","description":"Xương tạo nên bộ khung nâng đỡ cơ thể, bảo vệ nội tạng và làm điểm bám cho cơ. Mô bên trong xương còn dự trữ khoáng chất và sinh ra tế bào máu."},{"id":"muscular","name":"Hệ cơ","color":"#a85b50","description":"Cơ vân sinh ra vận động bằng cách kéo vào các điểm bám. Cùng với gân, chúng làm cử động khớp, giữ tư thế và sinh nhiệt."},{"id":"cardiac","name":"Tim","color":"#b96760","description":"Tim là khối cơ bơm máu với bốn buồng. Các van tim hướng dòng máu đi một chiều qua vòng tuần hoàn phổi và vòng tuần hoàn hệ thống."},{"id":"sensory","name":"Cơ quan giác quan","color":"#b0c8ce","description":"Các cấu trúc đảm nhiệm những giác quan đặc biệt như thị giác, thính giác và thăng bằng. Mô chuyên biệt của chúng bắt kích thích rồi phối hợp với hệ thần kinh để truyền tin."},{"id":"arterial","name":"Động mạch","color":"#c05245","description":"Tim đẩy máu đi khắp vòng tuần hoàn. Động mạch dẫn máu rời tim để nuôi mô, riêng vòng tiểu tuần hoàn thì dẫn máu lên phổi."},{"id":"venous","name":"Tĩnh mạch","color":"#527c9f","description":"Tĩnh mạch đưa máu trở về tim. Mạng nông và mạng sâu gom máu từ các mô; tĩnh mạch phổi mang máu giàu oxy từ phổi về."},{"id":"nervous","name":"Hệ thần kinh","color":"#d8b565","description":"Não, tuỷ sống và dây thần kinh ngoại biên dẫn truyền và xử lý tín hiệu, đảm nhiệm cảm giác, vận động, phối hợp và điều hoà tự động các chức năng cơ thể."},{"id":"respiratory","name":"Hệ hô hấp","color":"#b98991","description":"Đường dẫn khí đưa không khí tới phổi, nơi oxy và carbon dioxide trao đổi giữa khí và máu. Hô hấp dựa vào chênh lệch áp suất do các cơ hô hấp tạo ra."},{"id":"digestive","name":"Hệ tiêu hoá","color":"#b8916b","description":"Ống tiêu hoá phân giải thức ăn, hấp thu dưỡng chất và nước rồi đẩy chất thải đi tiếp. Các tạng phụ thuộc góp mật và men tiêu hoá."},{"id":"urinary","name":"Hệ tiết niệu","color":"#b47961","description":"Thận lọc máu và điều hoà cân bằng dịch, điện giải, toan kiềm. Nước tiểu theo niệu quản xuống bàng quang rồi ra ngoài qua niệu đạo."},{"id":"lymphatic","name":"Hệ bạch huyết","color":"#879f7c","description":"Mạch bạch huyết đưa dịch mô dư thừa trở lại tuần hoàn. Hạch bạch huyết và các cơ quan lympho khác đảm nhiệm giám sát và đáp ứng miễn dịch."},{"id":"endocrine","name":"Hệ nội tiết","color":"#c5a09a","description":"Các tuyến nội tiết tiết hormone vào máu để điều phối những quá trình như chuyển hoá, tăng trưởng, đáp ứng stress và sinh sản."},{"id":"reproductive","name":"Hệ sinh dục","color":"#bda098","description":"Các cấu trúc sinh dục nam trong bộ dữ liệu này tham gia sinh tinh, làm tinh trùng trưởng thành, vận chuyển tinh trùng và sản xuất hormone sinh dục."},{"id":"integumentary","name":"Bề mặt cơ thể","color":"#ba9b7d","description":"Bề mặt cơ thể là mốc giải phẫu bên ngoài. Hệ da tạo hàng rào bảo vệ, góp phần vào cảm giác và điều hoà thân nhiệt."},{"id":"connective","name":"Mô liên kết","color":"#aec3bb","description":"Sụn, dây chằng và các mô liên kết khác nâng đỡ, nối và ngăn cách các cấu trúc. Chúng giữ vững khớp và phân tán tải cơ học."}],"atlasPath":"data:application/json;base64,","resourceBase":"https://offline.soma.local/api/mobile/viewer/tim-day-du"},"buffers":{"scene.bin.gz":"ecfd1b51ae997177dad70f82"}}