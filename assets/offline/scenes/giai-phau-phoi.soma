ote":"","sources":[],"category":"venous"},"FJ3059":{"id":"FJ3059","meshName":"FJ3059","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Right lateral basal segmental vein","english":"Right lateral basal segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3060":{"id":"FJ3060","meshName":"FJ3060","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Right lateral basal segmental vein","english":"Right lateral basal segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3061":{"id":"FJ3061","meshName":"FJ3061","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Right lateral basal segmental vein","english":"Right lateral basal segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3062":{"id":"FJ3062","meshName":"FJ3062","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Right lateral basal segmental vein","english":"Right lateral basal segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3063":{"id":"FJ3063","meshName":"FJ3063","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Right superior segmental vein","english":"Right superior segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3064":{"id":"FJ3064","meshName":"FJ3064","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Apical part of right apical segmental vein","english":"Apical part of right apical segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3065":{"id":"FJ3065","meshName":"FJ3065","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Right superior segmental vein","english":"Right superior segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3066":{"id":"FJ3066","meshName":"FJ3066","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Right superior segmental vein","english":"Right superior segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3067":{"id":"FJ3067","meshName":"FJ3067","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Apical part of right apical segmental vein","english":"Apical part of right apical segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3068":{"id":"FJ3068","meshName":"FJ3068","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Apical part of right apical segmental vein","english":"Apical part of right apical segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3069":{"id":"FJ3069","meshName":"FJ3069","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Right posterior segmental vein","english":"Right posterior segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ3070":{"id":"FJ3070","meshName":"FJ3070","label":"Tĩnh mạch phổi và tĩnh mạch phân thùy — Right posterior segmental vein","english":"Right posterior segmental vein","latin":"","note":"","sources":[],"category":"venous"},"FJ1933":{"id":"FJ1933","meshName":"FJ1933","label":"Động mạch phế quản (hệ dinh dưỡng) — Bronchial artery","english":"Bronchial artery","latin":"","note":"","sources":[],"category":"arterial"},"FJ3418":{"id":"FJ3418","meshName":"FJ3418","label":"Động mạch phế quản (hệ dinh dưỡng) — Bronchial branch of arch of aorta","english":"Bronchial branch of arch of aorta","latin":"","note":"","sources":[],"category":"arterial"},"FJ2424":{"id":"FJ2424","meshName":"FJ2424","label":"Tâm nhĩ phải — Cavity of right atrium","english":"Cavity of right atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2439":{"id":"FJ2439","meshName":"FJ2439","label":"Tâm nhĩ phải — Wall of right atrium","english":"Wall of right atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2423":{"id":"FJ2423","meshName":"FJ2423","label":"Tâm thất phải — Cavity of right ventricle","english":"Cavity of right ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2419":{"id":"FJ2419","meshName":"FJ2419","label":"Cơ nhú · phải","english":"Anterior papillary muscle of right ventricle","latin":"Musculus papillaris","note":"Các trụ cơ nhô từ thành thất, nối với bờ lá van bằng dây chằng gân. Chúng co CÙNG LÚC với thất để căng dây chằng, giữ lá van không lộn ngược lên nhĩ. Nhồi máu cơ tim làm đứt cơ nhú gây hở van cấp tính và phù phổi tối cấp.","sources":[{"title":"Chú thích giải phẫu đã biên tập trong Soma","path":"src/lib/scenes (tim-day-du/papillary)"}],"category":"cardiac"},"FJ2430":{"id":"FJ2430","meshName":"FJ2430","label":"Tâm thất phải — Posterior papillary muscle of right ventricle","english":"Posterior papillary muscle of right ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2437":{"id":"FJ2437","meshName":"FJ2437","label":"Tâm thất phải — Septal papillary muscle of right ventricle","english":"Septal papillary muscle of right ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2425":{"id":"FJ2425","meshName":"FJ2425","label":"Tâm nhĩ trái — Cavity of left atrium","english":"Cavity of left atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2438":{"id":"FJ2438","meshName":"FJ2438","label":"Tâm nhĩ trái — Wall of left atrium","english":"Wall of left atrium","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2422":{"id":"FJ2422","meshName":"FJ2422","label":"Tâm thất trái — Cavity of left ventricle","english":"Cavity of left ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2418":{"id":"FJ2418","meshName":"FJ2418","label":"Tâm thất trái — Anterolateral head of lateral papillary muscle of left ventricle","english":"Anterolateral head of lateral papillary muscle of left ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ2429":{"id":"FJ2429","meshName":"FJ2429","label":"Tâm thất trái — Lateral papillary muscle of left ventricle","english":"Lateral papillary muscle of left ventricle","latin":"","note":"","sources":[],"category":"cardiac"},"FJ3411":{"id":"FJ3411","meshName":"FJ3411","label":"Động mạch chủ — Arch of aorta","english":"Arch of aorta","latin":"","note":"","sources":[],"category":"arterial"}},"systems":[{"id":"skeletal","name":"Hệ xương","color":"#e2d9ba","description":"Xương tạo nên bộ khung nâng đỡ cơ thể, bảo vệ nội tạng và làm điểm bám cho cơ. Mô bên trong xương còn dự trữ khoáng chất và sinh ra tế bào máu."},{"id":"muscular","name":"Hệ cơ","color":"#a85b50","description":"Cơ vân sinh ra vận động bằng cách kéo vào các điểm bám. Cùng với gân, chúng làm cử động khớp, giữ tư thế và sinh nhiệt."},{"id":"cardiac","name":"Tim","color":"#b96760","description":"Tim là khối cơ bơm máu với bốn buồng. Các van tim hướng dòng máu đi một chiều qua vòng tuần hoàn phổi và vòng tuần hoàn hệ thống."},{"id":"sensory","name":"Cơ quan giác quan","color":"#b0c8ce","description":"Các cấu trúc đảm nhiệm những giác quan đặc biệt như thị giác, thính giác và thăng bằng. Mô chuyên biệt của chúng bắt kích thích rồi phối hợp với hệ thần kinh để truyền tin."},{"id":"arterial","name":"Động mạch","color":"#c05245","description":"Tim đẩy máu đi khắp vòng tuần hoàn. Động mạch dẫn máu rời tim để nuôi mô, riêng vòng tiểu tuần hoàn thì dẫn máu lên phổi."},{"id":"venous","name":"Tĩnh mạch","color":"#527c9f","description":"Tĩnh mạch đưa máu trở về tim. Mạng nông và mạng sâu gom máu từ các mô; tĩnh mạch phổi mang máu giàu oxy từ phổi về."},{"id":"nervous","name":"Hệ thần kinh","color":"#d8b565","description":"Não, tuỷ sống và dây thần kinh ngoại biên dẫn truyền và xử lý tín hiệu, đảm nhiệm cảm giác, vận động, phối hợp và điều hoà tự động các chức năng cơ thể."},{"id":"respiratory","name":"Hệ hô hấp","color":"#b98991","description":"Đường dẫn khí đưa không khí tới phổi, nơi oxy và carbon dioxide trao đổi giữa khí và máu. Hô hấp dựa vào chênh lệch áp suất do các cơ hô hấp tạo ra."},{"id":"digestive","name":"Hệ tiêu hoá","color":"#b8916b","description":"Ống tiêu hoá phân giải thức ăn, hấp thu dưỡng chất và nước rồi đẩy chất thải đi tiếp. Các tạng phụ thuộc góp mật và men tiêu hoá."},{"id":"urinary","name":"Hệ tiết niệu","color":"#b47961","description":"Thận lọc máu và điều hoà cân bằng dịch, điện giải, toan kiềm. Nước tiểu theo niệu quản xuống bàng quang rồi ra ngoài qua niệu đạo."},{"id":"lymphatic","name":"Hệ bạch huyết","color":"#879f7c","description":"Mạch bạch huyết đưa dịch mô dư thừa trở lại tuần hoàn. Hạch bạch huyết và các cơ quan lympho khác đảm nhiệm giám sát và đáp ứng miễn dịch."},{"id":"endocrine","name":"Hệ nội tiết","color":"#c5a09a","description":"Các tuyến nội tiết tiết hormone vào máu để điều phối những quá trình như chuyển hoá, tăng trưởng, đáp ứng stress và sinh sản."},{"id":"reproductive","name":"Hệ sinh dục","color":"#bda098","description":"Các cấu trúc sinh dục nam trong bộ dữ liệu này tham gia sinh tinh, làm tinh trùng trưởng thành, vận chuyển tinh trùng và sản xuất hormone sinh dục."},{"id":"integumentary","name":"Bề mặt cơ thể","color":"#ba9b7d","description":"Bề mặt cơ thể là mốc giải phẫu bên ngoài. Hệ da tạo hàng rào bảo vệ, góp phần vào cảm giác và điều hoà thân nhiệt."},{"id":"connective","name":"Mô liên kết","color":"#aec3bb","description":"Sụn, dây chằng và các mô liên kết khác nâng đỡ, nối và ngăn cách các cấu trúc. Chúng giữ vững khớp và phân tán tải cơ học."}],"atlasPath":"data:application/json;base64,","resourceBase":"https://offline.soma.local/api/mobile/viewer/giai-phau-phoi"},"buffers":{"scene.bin.gz":"e8a4d494c135f49eca2ea6e4"}}